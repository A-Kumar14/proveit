# Model calls. OpenRouter is used when its key is set, otherwise the Gemini key below.
# Without either, the two authored demo concepts use deterministic judges.
OPENROUTER_API_KEY=
# Optional. Defaults to google/gemini-3.8-flash.
OPENROUTER_MODEL=

# Direct Gemini API, used only when no OpenRouter key is set.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional. Defaults to gemini-3.8-flash.
GEMINI_MODEL=
# Optional local SQLite path. Defaults to .data/proveit.sqlite outside tests/Vercel.
# For deployed persistence, point this at durable storage or replace the persistence adapter.
PROVEIT_DB_PATH=

# Accounts, via Clerk (https://dashboard.clerk.com). Create an application, then copy its two keys here.
# With both set, every page requires sign-in. Without them the app runs open as one local learner.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Speech mode voice (optional). Without a key the browser's own voice is used.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=

# Optional local SignBridge-ML inference service. See docs/signbridge.md.
SIGNBRIDGE_SERVICE_URL=http://127.0.0.1:8001
# Optional multi-frame movement recognition provider (set in the Python service shell, not just Next.js).
# Choices: amd | openai | hf. Leave keys blank to use static hand-letter recognition only.
SIGNBRIDGE_PROVIDER=amd
AMD_DEV_CLOUD_BASE_URL=
AMD_DEV_CLOUD_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=
