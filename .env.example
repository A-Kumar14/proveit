# Model calls. OpenRouter is used when its key is set, otherwise the Gemini key below.
# With neither, the app runs on deterministic demo judges.
OPENROUTER_API_KEY=
# Optional. Defaults to google/gemini-3.8-flash.
OPENROUTER_MODEL=

# Direct Gemini API, used only when no OpenRouter key is set.
GOOGLE_GENERATIVE_AI_API_KEY =
# Optional. Defaults to gemini-3.8-flash.
GEMINI_MODEL= 
# Set to 1 to show the two demo upload items in the Add file menu.
NEXT_PUBLIC_DEMO_MODE=
# Set to demo to start with made-up progress, two sample courses and a sample calendar. Anything else starts empty.
PROVEIT_DATA=
